# Postgres (matches docker-compose.yml for local dev). Still needed here:
# Prisma owns the schema/migrations and NextAuth reads the User table
# directly to authenticate — the sunset (Spring Boot) service reads/writes
# every other table (Room, RatePlan, Availability, Booking) against this
# same database.
DATABASE_URL="postgresql://sunsetbeach:sunsetbeach@localhost:5434/sunsetbeach"

# NextAuth — generate a secret with: openssl rand -base64 32
# Must be byte-for-byte the same secret the sunset (Java) service uses to
# decrypt the next-auth.session-token cookie (NEXTAUTH_SECRET there).
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Only needed in production, and only when the frontend and the sunset API
# are on different subdomains of the same parent domain (e.g.
# www.sunsetbeach.com / api.sunsetbeach.com) — scopes the session cookie to
# the shared parent domain (".sunsetbeach.com") so the browser will attach it
# to cross-subdomain admin fetches. Leave unset for local dev (both sides are
# "localhost", just on different ports, and cookies aren't port-scoped).
AUTH_COOKIE_DOMAIN=""

# Base URL of the sunset (Spring Boot) API, including its /api context path.
# BACKEND_API_URL is used for server-to-server calls (Server Components) and
# may be an internal/Docker-only hostname. NEXT_PUBLIC_BACKEND_API_URL is
# bundled into client-side JS and must always be reachable by the browser —
# in this Docker setup it has to be supplied as a build arg (see Dockerfile),
# not just an env var, since NEXT_PUBLIC_* values are inlined at build time.
BACKEND_API_URL="http://localhost:8080/api"
NEXT_PUBLIC_BACKEND_API_URL="http://localhost:8080/api"

# Seed script: initial admin account
SEED_ADMIN_EMAIL="admin@sunsetbeach.example"
SEED_ADMIN_PASSWORD="change-me-after-first-login"
