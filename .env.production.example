# Copy this file to .env.production and fill in real values before deploying.
# NEVER commit the resulting .env.production file (it is already gitignored).

# ---- Session cookie ----
# Whether the httpOnly session cookie set by app/api/session/login is marked
# `secure` (browser only sends it over HTTPS). This VPS's ISP blocks inbound
# 80/443, so this deployment serves plain HTTP on :8888 with no TLS and no
# Let's Encrypt certificate — `secure` cookies are silently dropped by the
# browser over plain HTTP, which would break every admin login. NODE_ENV is
# "production" here too, so `secure` can't just be derived from that the way
# frameworks usually do — leave this "false" until this deployment actually
# terminates TLS in front of the app (e.g. a real domain + Let's Encrypt, or
# a Cloudflare Tunnel), then flip it to "true".
COOKIE_SECURE="false"

# ---- sunset (Spring Boot) API ----
# NEXT_PUBLIC_BACKEND_API_URL must ALSO be passed as a Docker build-arg (see
# Dockerfile / docker-compose.prod.yml `app.build.args`), not just here —
# Next.js inlines NEXT_PUBLIC_* values into the client bundle at `next build`
# time, and this file is only read at container start, after the image is
# already built. Changing this value later means rebuilding the image with
# --build-arg, not just restarting the container with a new .env.production.
#
# BACKEND_API_URL (server-side only) has no safe universal default — which
# hostname:port reaches sunset depends entirely on how it's deployed
# relative to this container, so pick ONE of the following and don't leave
# host.docker.internal here as a placeholder if it doesn't actually apply:
#
#   (a) sunset is a container on the SAME shared Docker network as this app
#       (see DB_NETWORK_NAME / docker-compose.prod.yml) — use its
#       docker-compose *service name* and *internal* container port (the one
#       it listens on inside the container, e.g. 8080 — NOT whatever port it
#       happens to publish to the host, e.g. 8082). Find the exact name with
#       `docker compose ps` in sunset's own project directory:
#         BACKEND_API_URL="http://sunset-backend-1:8080/api"
#
#   (b) sunset is NOT on this Docker network (bare process, or its own
#       isolated compose project with no shared network) and is reachable
#       only via a port it publishes on the host — requires
#       `extra_hosts: ["host.docker.internal:host-gateway"]` on `app` in
#       docker-compose.prod.yml (not present by default; add it back if you
#       need this case), and the port must be whatever it actually publishes
#       to the host, not assumed to be 8080:
#         BACKEND_API_URL="http://host.docker.internal:8082/api"
#
# NEXT_PUBLIC_BACKEND_API_URL (browser-side) must be the public URL instead,
# in either case — nginx proxies /api/* on the same domain to sunset (see
# nginx/conf.d/app.conf), so this is same-origin from the browser's point of
# view and needs no CORS/cookie-domain configuration.
BACKEND_API_URL="http://sunset-backend-1:8080/api"
NEXT_PUBLIC_BACKEND_API_URL="http://thesunsetbeachsip.ddns.net:8888/api"

NODE_ENV=production
