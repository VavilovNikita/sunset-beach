# Copy this file to .env.production and fill in real values before deploying.
# NEVER commit the resulting .env.production file (it is already gitignored).

# ---- Postgres (read by the "db" service) ----
POSTGRES_USER=sunsetbeach
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_DB=sunsetbeach

# ---- App database connection (read by the "app" service) ----
# Host is "db" — the docker-compose service name on the internal network,
# NOT localhost. User/password/db must match the POSTGRES_* values above.
DATABASE_URL="postgresql://sunsetbeach:replace-with-a-strong-random-password@db:5432/sunsetbeach"

# ---- NextAuth ----
# Generate with: openssl rand -base64 32
# Must be byte-for-byte the same secret the sunset (Java) service uses to
# decrypt the next-auth.session-token cookie.
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="https://prostak59.duckdns.org"

# ---- Cookie domain ----
# Only set this if the frontend and the sunset API are deployed on different
# subdomains of the same parent domain (e.g. www.example.com / api.example.com).
# Leave empty if both are served from the same origin (e.g. both behind
# prostak59.duckdns.org via reverse-proxy path routing).
AUTH_COOKIE_DOMAIN=""

# ---- sunset (Spring Boot) API ----
# NEXT_PUBLIC_BACKEND_API_URL must ALSO be passed as a Docker build-arg (see
# Dockerfile / docker-compose.prod.yml `app.build.args`), not just here —
# Next.js inlines NEXT_PUBLIC_* values into the client bundle at `next build`
# time, and this file is only read at container start, after the image is
# already built.
#
# BACKEND_API_URL (server-side only) goes straight to the sunset container
# over the host, bypassing nginx/TLS — sunset's own docker-compose.yml binds
# it to 127.0.0.1:8080 on this same VPS, and docker-compose.prod.yml's `app`
# service maps host.docker.internal to the host gateway so this resolves.
# NEXT_PUBLIC_BACKEND_API_URL (browser-side) must be the public URL instead,
# since the browser can't resolve host.docker.internal — nginx proxies
# /api/* on the same domain to sunset (see nginx/conf.d/app.conf), so this
# is same-origin from the browser's point of view and needs no CORS/cookie-
# domain configuration.
BACKEND_API_URL="http://host.docker.internal:8080/api"
NEXT_PUBLIC_BACKEND_API_URL="https://prostak59.duckdns.org/api"

# ---- Seed script: initial admin account (used once by `npm run db:seed`) ----
SEED_ADMIN_EMAIL="admin@prostak59.duckdns.org"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"

NODE_ENV=production
